rules_version = '2';

// Webクライアントは Firestore へ直接アクセスしない。すべて Cloud Run の /api を通す。
// Cloud Run のサービスアカウントは Admin 権限で接続するため、このルールを迂回する。
// サーバー側で userId の所有権を確認することが前提であり、Rules だけに依存しない（§10.2）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
