{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-agent.local/schemas/event.json",
  "title": "Event",
  "$defs": {
    "EventLocationType": {
      "type": "string",
      "enum": ["online", "offline", "hybrid", "unknown"]
    },
    "EventLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/EventLocationType" },
        "venue": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "nearestStation": {
          "type": ["string", "null"],
          "description": "会場の最寄駅名（駅すぱあと経路検索の到着駅として使用）"
        }
      }
    },
    "DatePrecision": {
      "type": "string",
      "enum": ["datetime", "date", "unknown"]
    },
    "EventKind": {
      "type": "string",
      "description": "機会の種別。絞り込みとラベル表の切り替えに使う（ジャンル拡張計画）",
      "enum": ["hackathon", "contest", "accelerator", "cocreation", "exhibition", "subsidy", "meetup"]
    },
    "EventMilestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "at", "precision"],
      "description": "締切と実施日のあいだの節目（一次選考通過発表、最終審査会、結果発表など）",
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "at": { "type": "string", "format": "date-time" },
        "precision": { "type": "string", "enum": ["datetime", "date"] }
      }
    },
    "EventDates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventStartPrecision", "timezone"],
      "properties": {
        "applicationDeadline": { "type": ["string", "null"], "format": "date-time" },
        "applicationDeadlinePrecision": { "$ref": "#/$defs/DatePrecision" },
        "eventStart": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "実施（開始）日時。締切だけが分かっている告知では null（ビジコン・補助金）"
        },
        "eventStartPrecision": {
          "type": "string",
          "enum": ["datetime", "date", "unknown"]
        },
        "eventEnd": { "type": ["string", "null"], "format": "date-time" },
        "milestones": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/EventMilestone" }
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone identifier (e.g. Asia/Tokyo)"
        }
      }
    },
    "ValidationStatus": {
      "type": "string",
      "enum": ["verified", "partial", "quarantined", "rejected"]
    },
    "EventRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" }
      }
    },
    "EventLifecycleStatus": {
      "type": "string",
      "enum": ["suggested", "bookmarked", "dismissed"],
      "description": "ユーザーによる選別の状態。上位要件 §6.2 が挙げる added_to_calendar は含めない。カレンダー登録状態は詳細要件 §7.3 に従い googleCalendarEventIds で表現し、選別状態と登録状態を独立に保持する。"
    },
    "EvidencePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "sourceType", "supports", "excerpt"],
      "description": "一覧に添える根拠の要約。全文は GET /api/events/{eventId}/evidence（§7.2）",
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceType": { "$ref": "evidence.json#/$defs/EvidenceSourceType" },
        "supports": { "type": "array", "items": { "$ref": "evidence.json#/$defs/SupportedField" } },
        "excerpt": { "type": "string", "maxLength": 160 }
      }
    },
    "GoogleCalendarEventIds": {
      "type": "object",
      "additionalProperties": false,
      "description": "登録済みGoogleカレンダー予定のID。申込締切と本番日程を別々に保持する（要件定義書 §6.2）。未登録は null。",
      "properties": {
        "deadlineEventId": { "type": ["string", "null"] },
        "mainEventId": { "type": ["string", "null"] }
      }
    },
    "OrganizerEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedAt", "pageUrl", "values"],
      "description": "主催者による編集（ADR-013）。確認コードをイベントページで見つけた時刻とページ、直した値",
      "properties": {
        "verifiedAt": { "type": "string", "format": "date-time" },
        "pageUrl": { "type": "string", "format": "uri", "description": "確認コードを見つけたページ" },
        "editedAt": { "type": ["string", "null"], "format": "date-time" },
        "values": { "$ref": "#/$defs/OrganizerEditValues" }
      }
    },
    "OrganizerEditValues": {
      "type": "object",
      "additionalProperties": false,
      "description": "主催者が直せる項目。書かれていない項目は収集した値のまま",
      "properties": {
        "nearestStation": { "type": ["string", "null"], "maxLength": 40 },
        "venue": { "type": ["string", "null"], "maxLength": 120 },
        "applicationDeadline": { "type": ["string", "null"], "format": "date-time" },
        "applicationUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "userId",
        "title",
        "normalizedTitle",
        "summary",
        "category",
        "kind",
        "location",
        "dates",
        "officialUrl",
        "validationStatus",
        "confidence",
        "evidenceIds",
        "dedupKey",
        "firstSeenAt",
        "lastSeenAt",
        "sourceRunId",
        "status"
      ],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "normalizedTitle": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/EventKind" },
        "organizer": { "type": ["string", "null"] },
        "location": { "$ref": "#/$defs/EventLocation" },
        "dates": { "$ref": "#/$defs/EventDates" },
        "officialUrl": { "type": "string", "format": "uri" },
        "applicationUrl": { "type": ["string", "null"], "format": "uri" },
        "validationStatus": { "$ref": "#/$defs/ValidationStatus" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dedupKey": { "type": "string", "minLength": 1 },
        "recommendation": {
          "oneOf": [{ "$ref": "#/$defs/EventRecommendation" }, { "type": "null" }]
        },
        "firstSeenAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "sourceRunId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/EventLifecycleStatus" },
        "googleCalendarEventIds": { "$ref": "#/$defs/GoogleCalendarEventIds" },
        "themeId": { "type": ["string", "null"], "description": "収集したテーマ（ADR-008）。手動 Run 由来は null" },
        "normalizedOfficialUrl": { "type": "string", "description": "officialUrl の正規化形。既知ページの照合キー" },
        "lastExtractedAt": { "type": ["string", "null"], "format": "date-time", "description": "本文から実際に抽出した最終時刻。lastSeenAt と違い、既知ページの省略では進まない" },
        "organizerEdit": {
          "oneOf": [{ "$ref": "#/$defs/OrganizerEdit" }, { "type": "null" }],
          "description": "本人確認した主催者が直した値（ADR-013）。再収集でも保たれ、保存のたびに当て直す"
        },
        "attributes": {
          "type": "object",
          "maxProperties": 10,
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 60 },
          "description": "ジャンル固有の値（賞金・支援内容・対象ステージなど）。ページの行をそのまま持ち、構造化はしない（ジャンル拡張計画 段階2）"
        },
        "evidencePreview": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/EvidencePreview" },
          "description": "一覧用。締切・開催日・タイトルの根拠を最大4件。サーバーが list 応答で添える"
        },
        "source": {
          "type": "string",
          "deprecated": true,
          "description": "出典の表示用文字列。Phase 1 の暫定項目で、evidence.json の Evidence.sourceType へ統合して廃止する。"
        }
      }
    },
    "EventListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "lastCollectedAt": { "type": ["string", "null"], "format": "date-time", "description": "最後に収集が保存された時刻（一覧の「最終収集」表示用）" },

        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/Event" }
        }
      }
    }
  }
}
