{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-agent.local/schemas/agent-run.json",
  "title": "Agent Run API",
  "$defs": {
    "AgentRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "partial_success",
        "failed",
        "cancelled"
      ]
    },
    "AgentRunTriggerType": {
      "type": "string",
      "enum": ["manual", "scheduled"]
    },
    "CreateAgentRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forceRefresh": { "type": "boolean", "default": false },
        "sessionId": {
          "type": "string",
          "description": "Chat session whose preferences the run should use. Omitted: default preferences"
        }
      }
    },
    "CreateAgentRunResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "status"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "const": "queued"
        }
      }
    },
    "RunAgent": {
      "type": "string",
      "description": "Which role of the pipeline produced an activity line (section 6 steps grouped for display)",
      "enum": ["planner", "searcher", "extractor", "organizer"]
    },
    "RunActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "message", "at"],
      "properties": {
        "agent": { "$ref": "#/$defs/RunAgent" },
        "message": { "type": "string", "maxLength": 300, "description": "User-facing line; never a prompt, a secret or a stack trace (section 8.2)" },
        "level": { "type": "string", "enum": ["info", "warn"] },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "AgentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "userId", "triggerType", "idempotencyKey", "status", "startedAt"],
      "properties": {
        "activity": {
          "type": "array",
          "maxItems": 80,
          "items": { "$ref": "#/$defs/RunActivity" },
          "description": "What each role did, in order. Bounded so the run document stays small"
        },
        "runId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "minLength": 1 },
        "triggerType": { "$ref": "#/$defs/AgentRunTriggerType" },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/AgentRunStatus" },
        "currentStep": { "type": "string" },
        "model": { "type": "string" },
        "queryCount": { "type": "integer", "minimum": 0 },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "verifiedCount": { "type": "integer", "minimum": 0 },
        "partialCount": { "type": "integer", "minimum": 0 },
        "quarantinedCount": { "type": "integer", "minimum": 0 },
        "rejectedCount": { "type": "integer", "minimum": 0 },
        "duplicateCount": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "errorMessage": {
          "type": ["string", "null"],
          "description": "User-safe error summary; no stack traces or secrets (section 8.2)"
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
