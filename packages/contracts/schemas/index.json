{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-agent.local/schemas/index.json",
  "title": "Event Agent schema catalog",
  "description": "Index of shared API and domain JSON Schemas for the Osaka hackathon event agent project.",
  "schemas": [
    {
      "id": "chat",
      "path": "chat.json",
      "definitions": [
        "UserPreferences",
        "ChatAction",
        "ChatRequest",
        "ChatResponse"
      ]
    },
    {
      "id": "agent-run",
      "path": "agent-run.json",
      "definitions": [
        "AgentRunStatus",
        "AgentRunTriggerType",
        "CreateAgentRunRequest",
        "RunAgent",
        "RunActivity",
        "CreateAgentRunResponse",
        "AgentRun"
      ]
    },
    {
      "id": "event",
      "path": "event.json",
      "definitions": [
        "Event",
        "EventKind",
        "EventMilestone",
        "EventLocation",
        "EventDates",
        "EventRecommendation",
        "EvidencePreview",
        "GoogleCalendarEventIds",
        "EventListResponse",
        "OrganizerEdit",
        "OrganizerEditValues"
      ]
    },
    {
      "id": "route",
      "path": "route.json",
      "definitions": [
        "Station",
        "RouteLeg",
        "RouteSummary",
        "EventRouteResponse"
      ]
    },
    {
      "id": "evidence",
      "path": "evidence.json",
      "definitions": [
        "Evidence",
        "EvidenceSourceType",
        "SupportedField",
        "GroundingMetadata",
        "EvidenceListResponse"
      ]
    },
    {
      "id": "organizer-post",
      "path": "organizer-post.json",
      "definitions": [
        "PostOrigin",
        "PostStatus",
        "PlacementKind",
        "PostPlacement",
        "PostIssueCode",
        "PostIssue",
        "OrganizerPostRequest",
        "OrganizerPost",
        "OrganizerPostPreviewResponse",
        "OrganizerPostCreateResponse",
        "OrganizerPostListResponse",
        "MetricCounts",
        "EventMetrics",
        "PostMetricsResponse",
        "MetricEventRequest"
      ]
    },
    {
      "id": "pool-search",
      "path": "pool-search.json",
      "definitions": [
        "PoolSearchRequest",
        "SearchIntent",
        "SearchAgent",
        "SearchActivity",
        "PoolSearchResponse",
        "PoolSearchActivity",
        "PoolSearchStreamEvent"
      ]
    },
    {
      "id": "event-claim",
      "path": "event-claim.json",
      "definitions": [
        "EventClaimStartRequest",
        "EventClaimStartResponse",
        "EventClaimVerifyRequest",
        "EventClaimVerifyResponse",
        "EventEditRequest",
        "EventEditResponse"
      ]
    },
    {
      "id": "web-search",
      "path": "web-search.json",
      "definitions": [
        "WebSearchRequest",
        "WebSource",
        "WebSearchResponse"
      ]
    },
    {
      "id": "watched-page",
      "path": "watched-page.json",
      "definitions": [
        "WatchedPageRequest",
        "WatchedPageResponse",
        "WatchedPageStreamEvent"
      ]
    }
  ]
}
