{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-agent.local/schemas/route.json",
  "title": "EventRoute",
  "description": "駅すぱあと API による、イベント開始時刻に到着する経路の要約（GET /api/events/{eventId}/route?from=）",
  "$defs": {
    "Station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "prefecture": { "type": ["string", "null"] }
      }
    },
    "RouteLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "fromStation", "toStation"],
      "properties": {
        "line": { "type": "string" },
        "fromStation": { "type": "string" },
        "toStation": { "type": "string" },
        "departure": { "type": ["string", "null"], "format": "date-time" },
        "arrival": { "type": ["string", "null"], "format": "date-time" },
        "minutes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "RouteSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromStation", "toStation", "departure", "arrival", "totalMinutes", "transferCount", "legs"],
      "properties": {
        "fromStation": { "$ref": "#/$defs/Station" },
        "toStation": { "$ref": "#/$defs/Station" },
        "departure": { "type": "string", "format": "date-time" },
        "arrival": { "type": "string", "format": "date-time" },
        "totalMinutes": { "type": "integer", "minimum": 0 },
        "transferCount": { "type": "integer", "minimum": 0 },
        "fareYen": { "type": ["integer", "null"], "minimum": 0 },
        "legs": { "type": "array", "items": { "$ref": "#/$defs/RouteLeg" } }
      }
    },
    "EventRouteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "arriveBy", "route"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "arriveBy": { "type": "string", "format": "date-time" },
        "route": { "$ref": "#/$defs/RouteSummary" }
      }
    }
  }
}
