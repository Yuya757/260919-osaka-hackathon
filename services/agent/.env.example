GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
GEMINI_MODEL=gemini-2.0-flash
AGENT_DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8080
# 集約サイトのみを出典とするイベントを表示する下限（画面設計書§8-2）
AGGREGATOR_ONLY_MIN_CONFIDENCE=0.60
# 定期Runの冪等キーの版番号（§9.3）。同じ日にもう一度走らせたいときに上げる
RUN_SCHEDULE_VERSION=daily-1
# Firestore永続化（§7）。false のときは全データがプロセス内メモリに載る。
# Emulator に繋ぐときは FIRESTORE_EMULATOR_HOST=localhost:8081 も設定する。
FIRESTORE_ENABLED=false
FIRESTORE_DATABASE=(default)
# 駅すぱあと API アクセスキー（未設定なら経路検索は 503 を返す）
EKISPERT_API_KEY=
